{
  "name": "arcademint",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-ads-txt.mjs",
    "build": "pnpm validate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "tsx scripts/validate-site.ts",
    "generate:images": "tsx scripts/generate-images.ts",
    "generate:ads": "node scripts/generate-ads-txt.mjs",
    "test:i18n": "vitest run tests/i18n",
    "test:seo": "vitest run tests/seo",
    "test:e2e:locales": "playwright test tests/e2e/locales.spec.ts"
  },
  "dependencies": {
    "lucide-react": "^1.30.0",
    "matter-js": "0.20.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/matter-js": "0.20.2",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.0",
    "jsdom": "^27.4.0",
    "sharp": "^0.35.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
